{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Security": {
    "Jwt": {
      "Issuer": "HMS.Platform",
      "Audience": "HMS.Web",
      "TokenLifetimeMinutes": 480
    }
  },
  "PasswordSetup": {
    "FrontendBaseUrl": "http://localhost:4200",
    "TokenLifetimeHours": 48
  },
  "Email": {
    "FromAddress": "",
    "FromName": "HMS Platform",
    "ExposeLocalSetupLinks": true,
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": ""
    }
  },
  "ConnectionStrings": {
    "IdentityDb": "Host=localhost;Port=5432;Database=hms_identity;Username=postgres"
  }
}