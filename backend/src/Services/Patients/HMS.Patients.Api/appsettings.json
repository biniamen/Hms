{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Security": {
    "Jwt": {
      "Issuer": "HMS.Platform",
      "Audience": "HMS.Web",
      "TokenLifetimeMinutes": 480
    }
  },
  "RabbitMq": {
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "hms.events",
    "PatientRegisteredQueue": "hms.patient-registered",
    "PatientRegisteredRoutingKey": "patient.registered"
  }
}
