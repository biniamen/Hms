{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4300" ]
  },
  "Security": {
    "Jwt": {
      "Issuer": "HMS.Platform",
      "Audience": "HMS.Web",
      "TokenLifetimeMinutes": 480
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "employees": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/employees/{**catch-all}"
        }
      },
      "roles": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "permissions": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/permissions/{**catch-all}"
        }
      },
      "departments": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/departments/{**catch-all}"
        }
      },
      "doctors": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/doctors/{**catch-all}"
        }
      },
      "patients": {
        "ClusterId": "patients",
        "Match": {
          "Path": "/api/patients/{**catch-all}"
        }
      },
      "insurance-companies": {
        "ClusterId": "patients",
        "Match": {
          "Path": "/api/insurance-companies/{**catch-all}"
        }
      },
      "appointments": {
        "ClusterId": "patients",
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        }
      },
      "beds": {
        "ClusterId": "patients",
        "Match": {
          "Path": "/api/beds/{**catch-all}"
        }
      },
      "clinical": {
        "ClusterId": "clinical",
        "Match": {
          "Path": "/api/clinical/{**catch-all}"
        }
      },
      "billing": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/billing/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "patients": {
        "Destinations": {
          "destination1": {
            "Address": "http://patients-api:8080/"
          }
        }
      },
      "clinical": {
        "Destinations": {
          "destination1": {
            "Address": "http://clinical-api:8080/"
          }
        }
      },
      "billing": {
        "Destinations": {
          "destination1": {
            "Address": "http://billing-api:8080/"
          }
        }
      }
    }
  }
}
