{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "employees": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/employees/{**catch-all}"
        }
      },
      "roles": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "patients": {
        "ClusterId": "patients",
        "Match": {
          "Path": "/api/patients/{**catch-all}"
        }
      },
      "appointments": {
        "ClusterId": "appointments",
        "Match": {
          "Path": "/api/appointments/{**catch-all}"
        }
      },
      "beds": {
        "ClusterId": "appointments",
        "Match": {
          "Path": "/api/beds/{**catch-all}"
        }
      },
      "clinical": {
        "ClusterId": "clinical",
        "Match": {
          "Path": "/api/clinical/{**catch-all}"
        }
      },
      "billing": {
        "ClusterId": "billing",
        "Match": {
          "Path": "/api/billing/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity-api:8080/"
          }
        }
      },
      "patients": {
        "Destinations": {
          "destination1": {
            "Address": "http://patients-api:8080/"
          }
        }
      },
      "appointments": {
        "Destinations": {
          "destination1": {
            "Address": "http://appointments-api:8080/"
          }
        }
      },
      "clinical": {
        "Destinations": {
          "destination1": {
            "Address": "http://clinical-api:8080/"
          }
        }
      },
      "billing": {
        "Destinations": {
          "destination1": {
            "Address": "http://billing-api:8080/"
          }
        }
      }
    }
  }
}
